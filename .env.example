# Copy to .env and fill in. .env is gitignored.
# Supabase project settings -> API

# --- Node side: scripts/ and lib/ ------------------------------------------
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# service_role key: seeding only, NEVER ship to the browser
SUPABASE_SERVICE_ROLE_KEY=eyJ...
# anon key: safe for the frontend (read-only via RLS)
SUPABASE_ANON_KEY=eyJ...

# --- Expo front end ---------------------------------------------------------
# Expo only inlines variables prefixed EXPO_PUBLIC_, and anything inlined ships
# inside the app bundle where any user can read it. The anon key is built for
# that and is fenced in by RLS. The service_role key bypasses RLS, so it must
# never be given an EXPO_PUBLIC_ prefix.
EXPO_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJ...
